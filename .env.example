# ── BüKo ortam değişkenleri ──
# Kopyala: cp .env.example .env  ve gerçek değerleri gir.
# Hiçbir gerçek anahtar olmadan da proje mock modda çalışır (bkz. MANUAL_ACTIONS_REQUIRED.md).

# App
NODE_ENV=development
PORT=3000
# Webhook adresinin temeli. Railway'de BOŞ BIRAKIN — `RAILWAY_PUBLIC_DOMAIN`'den
# otomatik `https://<domain>` olarak türetilir (açık değer her zaman kazanır).
#
# ⚠️ Bot token'ı globaldir: aynı token'la yapılan her çağrı AYNI botu etkiler.
# Yerelde `TELEGRAM_MODE=webhook` ile açmak, o token'a ait webhook kaydını bu
# adresle EZER (D-043). Çözüm ayrı bir TEST BOTU'dur — bkz. Telegram bölümü.
PUBLIC_BASE_URL=http://localhost:3000

# ── LLM (Anthropic Claude) ──
# Anahtar yoksa LLM_MOCK=true ile deterministik mock yanıt kullanılır.
ANTHROPIC_API_KEY=
LLM_MOCK=true
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=2048

# ── OCR sağlayıcısı (bkz. DECISIONS D-010) ──
# claude-vision : Claude native vision. DİKKAT — mektup GÖRSELİ ham PII içerir ve
#                 Anthropic'e ulaşır. Maskeleme, sonraki tüm adımları (analiz, taslak,
#                 kalıcı depolama) korur.
# local         : tesseract.js ile yerel OCR — ham veri hiç dışarı çıkmaz (maks. gizlilik).
#                 Gerektirir: npm i tesseract.js
OCR_PROVIDER=claude-vision

# ── Telegram ──
#
# 🔑 YEREL GELİŞTİRMEDE ÜRETİM TOKEN'INI KULLANMAYIN.
# @BotFather'dan AYRI bir test botu açın (üretim: @BuKo749_bot ·
# test: @BuKoTest749_bot). Ayrı token = gerçek izolasyon: yerelde polling
# açmak üretimin update'lerini çalmaz, webhook kaydını ezmez.
# Servis açılışta hangi botu sürdüğünü loglar (D-047) — o satırı okuyun.
TELEGRAM_BOT_TOKEN=
# webhook | polling | disabled
# Test botuyla `polling` önerilir: tünel/public URL gerektirmez.
TELEGRAM_MODE=disabled
TELEGRAM_WEBHOOK_SECRET=
# Bakım script'leri için kaçış kapısı (D-043): true iken bot HİÇ başlatılmaz —
# ne webhook kaydı ne polling. `bootScriptContext()` bunu kendisi ayarlar;
# normalde `.env`'de false kalmalı.
TELEGRAM_SKIP_STARTUP=false

# ── Zamanlayıcı izolasyonu (D-047) ──
# ⚠️ Ayrı test botu Telegram KANALINI izole eder, VERİTABANINI ETMEZ.
# `DB_DRIVER=supabase` ile yerelde uygulama açmak, üretim verisine karşı
# İKİNCİ BİR ZAMANLAYICI çalıştırır: hatırlatmalar çift gönderilir veya
# üretim göndermeden önce "sent" işaretlenir (kullanıcı hiç almaz), GDPR
# silmesi çakışır. Railway'de `numReplicas: 1` olmasının sebebi de budur —
# yerel bir `start:dev` fiilen ikinci replikadır.
#
# YEREL GELİŞTİRMEDE: true yapın, VEYA `DB_DRIVER=memory` kullanın.
# Bakım script'lerinde `bootScriptContext()` bunu kendisi ayarlar.
SCHEDULER_SKIP_STARTUP=false

# ── Persistence ──
# memory | supabase
DB_DRIVER=memory
SUPABASE_URL=
# Backend BUNU kullanır. GİZLİ anahtardır (sb_secret_... / service_role JWT) ve
# RLS'i bypass eder. Publishable/anon anahtar BURAYA YAZILMAZ — politikasız RLS
# nedeniyle her sorgu reddedilir.
SUPABASE_SERVICE_ROLE_KEY=
# Herkese açık anahtar (sb_publishable_...). Yalnızca ileride bir istemci/web
# dashboard eklenirse gerekir; backend için YETERLİ DEĞİLDİR.
SUPABASE_ANON_KEY=

# ── PII Vault şifreleme ──
# openssl rand -hex 32  (64 hex karakter = 32 byte). Boşsa dev-only türetilmiş anahtar (uyarı loglanır).
PII_MASTER_KEY=

# ── Veri saklama (GDPR Art.17) ──
# Belge/analiz kaç gün sonra otomatik silinsin.
DATA_RETENTION_DAYS=30
# Silme cron ifadesi (her gün 03:00)
DELETION_CRON=0 3 * * *

# ── WhatsApp (opsiyonel, v2) ──
WHATSAPP_TOKEN=
