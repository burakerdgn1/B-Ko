{
  "name": "bueko",
  "version": "0.1.0",
  "description": "BüKo — AI Bureaucracy Copilot for expats in Germany (Telegram bot)",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,scripts}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "eval:prompts": "ts-node -T scripts/prompt-eval.ts",
    "check:supabase": "ts-node -T scripts/check-supabase.ts",
    "check:deploy": "ts-node -T scripts/check-deploy.ts",
    "rotate:supabase-key": "ts-node -T scripts/rotate-supabase-key.ts",
    "smoke:supabase": "ts-node -T scripts/smoke-supabase.ts",
    "test:supabase": "RUN_SUPABASE_TESTS=1 jest supabase.integration --testTimeout=30000",
    "rotate:pii-key": "ts-node -T scripts/rotate-pii-key.ts",
    "live:check": "ts-node -T scripts/live-check.ts",
    "bench:ocr-mask": "ts-node -T scripts/ocr-mask-bench.ts",
    "bench:ner-mask": "ts-node -T scripts/ner-mask-bench.ts",
    "check:real-fixtures": "ts-node -T scripts/check-real-fixtures.ts",
    "check:docs-sync": "ts-node -T scripts/check-docs-sync.ts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "@supabase/supabase-js": "^2.45.4",
    "grammy": "^1.30.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "playwright": "^1.48.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.4",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.68.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    },
    "setupFiles": [
      "<rootDir>/../jest.setup.ts"
    ]
  }
}
